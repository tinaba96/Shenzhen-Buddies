# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template, which holds no secrets and is the only place the
# required variables are documented. `.env*` was swallowing it, so a fresh
# clone had nothing to copy from and edits to it were invisible to review.
!.env.local.example

# vercel
.vercel

# local AI/dev-env state
/.claude/
/.omc/

# typescript
*.tsbuildinfo
next-env.d.ts

# founder photo originals — see marketing/assets/CONSENT.md
# Camera originals carry EXIF GPS coordinates and full-resolution faces, and
# git history is permanent: a face or a location committed by accident cannot
# be un-published. Only the process docs in this folder are tracked. What ships
# is the processed, metadata-stripped WebP in public/gallery/, which stays
# committed. Ignore-everything-then-allow-.md is deliberate — a raw format
# nobody listed (.dng, .arw, .cr2) is ignored by default rather than by luck.
marketing/assets/**
!marketing/assets/**/
!marketing/assets/**/*.md
