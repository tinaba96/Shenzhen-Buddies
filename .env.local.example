# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used by the Stripe webhook to write subscription rows that bypass RLS.
# NEVER prefix this with NEXT_PUBLIC_ and NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — used for both subscriptions (/pricing) and one-time booking
# payments (/guide). Leave STRIPE_SECRET_KEY blank during pilot to disable
# payment: bookings then skip checkout and go straight to admin review.
# Booking payments need the webhook to listen for:
#   checkout.session.completed, checkout.session.expired
# (subscriptions also use customer.subscription.* — see README).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_ID=price_...

# PayPal — optional second booking-payment method, shown on the payment page
# (/guide/pay/[id]) next to card. Leave blank to hide the PayPal button and use
# Stripe only. PAYPAL_ENV picks the API + which credentials to use:
#   sandbox → api-m.sandbox.paypal.com (test buyer accounts only)
#   live    → api-m.paypal.com (real money)
# The sandbox and live apps have DIFFERENT client id/secret — match PAYPAL_ENV
# to the pair you paste. NEXT_PUBLIC_PAYPAL_CLIENT_ID must equal PAYPAL_CLIENT_ID
# (it's the browser copy). Promo codes are validated via Stripe and applied to
# PayPal too; a 100%-off (free) booking hides PayPal and uses the $0 card path.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# The canonical site URL. Overrides DEFAULT_SITE_URL in src/lib/config.ts,
# which is https://www.shenzhen-buddies.com — the domain Google indexes and the
# one every canonical tag, sitemap entry, Stripe return URL and password-reset
# email resolves against. Note the www: the apex 308s to www, so www is the host
# that serves pages, and the canonical host has to be the one that answers 200.
#
# LEAVE BLANK unless you mean it. If this is set to a different host in the
# deployment environment, that host silently wins: canonical tags, the sitemap
# and share cards all point there instead, and the custom domain never gets
# credited. A stale value here is invisible until weeks of indexing are lost.
# Set it only for a preview deployment that must not claim the canonical domain.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID. When set, the GA tag loads (gtag.js) and
# UTM-tagged inbound links are attributed automatically. Leave blank to disable.
# NOTE: NEXT_PUBLIC_* values are baked at build time — redeploy after changing.
NEXT_PUBLIC_GA_ID=

# --- Beta: single operator-managed guide with bookings (migration 0008) ---

# While set, the app runs in "single guide" mode: /browse redirects to /guide
# and tourists book this guide instead of matching. Sign the guide up as a
# normal guide account and put their auth user id (UUID) here.
# Unset to bring the original matching experience back.
OFFICIAL_GUIDE_ID=

# Comma-separated operator emails. These accounts can open /admin (publish
# availability, approve/decline bookings) and receive new-request emails.
ADMIN_EMAILS=you@example.com

# Gmail SMTP for booking emails. Leave blank in local dev — emails are then
# logged to the server console instead of sent.
#   1. On the Gmail account, turn ON 2-Step Verification (use an Authenticator
#      app and share the setup key if the inbox is shared by two people).
#   2. Google Account → Security → App passwords → generate one (16 chars).
#   3. Put the account address in GMAIL_USER and the app password in
#      GMAIL_APP_PASSWORD (spaces optional).
# Because Gmail sends the mail itself, the @gmail.com From passes DMARC and
# reaches inboxes without owning a domain.
GMAIL_USER=tensaitech.admin@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM="Shenzhen Buddies <tensaitech.admin@gmail.com>"
